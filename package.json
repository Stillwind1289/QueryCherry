{
  "name": "querycherry",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
      "build": "vite build",
   "preview": "vite preview",
    "test": "node --test \"tests/**/*.test.js\"",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "bench": "node tests/stress-bench.js",
    "bench:moderate": "node tests/stress-bench.js --profile=moderate",
    "bench:scale": "node tests/stress-bench.js --profile=scale",
    "bench:browser:instructions": "echo \"Run npm run dev, then open /tests/browser/stress-bench.html in a browser\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.0.0",
    "lucide-react": ">=0.468.0 <1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql-formatter": "^15.6.10"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  }
}
